* text=auto

# Files in the verifyPrototype hash stamp are digested as raw bytes, so their
# checkout form must be identical on every platform or reports/*.sha256 can
# never be reproduced off macOS/Linux. Pin them to LF.
*.kt text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.xml text eol=lf

gradlew text eol=lf
gradlew.bat text eol=crlf whitespace=cr-at-eol
*.jar binary
*.png binary
*.bin binary
