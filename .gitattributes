* text=auto
# Pin source checkout line endings. Verification normalizes source text only; artifacts stay byte exact.
*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.xml text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf whitespace=cr-at-eol
*.jar binary
*.bin binary
*.ncp binary
*.png binary
*.zip binary
