* text=auto
# Pin source checkout line endings. Verification normalizes source text only; artifacts stay byte exact.
*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.swift text eol=lf
*.py text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.properties text eol=lf
*.xml text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf whitespace=cr-at-eol
*.jar binary
*.bin binary
*.ncp binary
*.png binary
*.zip binary
# Retain raw ADB output bytes, including native CR/CRLF and dump whitespace.
reports/current-api35-instrumentation/*.log binary
reports/current-api35-ui/activity-dump.txt binary
reports/current-api35-picker-recreation/events*.txt binary
reports/current-api35-picker-recreation/actions.jsonl text eol=lf
reports/current-api35-picker-process/events*.txt binary
reports/current-api35-picker-process/actions.jsonl text eol=lf
reports/current-api35-rendering/host/run.log binary
reports/current-api35-rendering/ordinary/render.log binary
reports/current-api35-rendering/ordinary/actions.jsonl text eol=lf
reports/store-owner-admission/before/run.log binary
reports/store-owner-admission/native/run.log binary
reports/store-owner-admission/before/tests.xml binary
reports/store-owner-admission/after/*.xml binary
