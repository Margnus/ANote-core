      "GRADLE_USER_HOME": "<repo>/.gradle-user-home",
      "KONAN_DATA_DIR": "<repo>/.konan"
    },
    "argv": [
      "./gradlew",
      "--offline",
      "--no-daemon",
      "-PenableAppleTargets=true",
